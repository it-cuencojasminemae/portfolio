// Cloudflare Workers config: serves the prerendered site (`npm run generate`) as static assets.
// No server code runs; static asset requests are free and unlimited.
{
  // Must match the project name in the Cloudflare dashboard.
  "name": "jasminecuenco",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./.output/public",
    // Unknown URLs get the generated 404.html with a real 404 status.
    "not_found_handling": "404-page"
  }
}
